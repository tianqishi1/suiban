# 复制为 .env 或直接设置环境变量后启动网关
# 百炼主 Key（只存云端，绝不下发设备）
DASHSCOPE_API_KEY=sk-xxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 管理接口令牌（签发/吊销设备令牌用）
SUISBAN_ADMIN_TOKEN=change-me-to-a-long-random-string
# 每设备滚动24小时 token 预算（默认 200 万）
SUISBAN_DAILY_TOKEN_BUDGET=2000000
# 本地无 Key 冒烟测试时设为 1
SUISBAN_MOCK=0
# 可选：模型别名路由与价格表覆盖（JSON）
# SUISBAN_MODEL_MAP={"suiban-main":"qwen3-max","suiban-vision":"qwen-vl-plus","suiban-light":"qwen-flash"}
# SUISBAN_PRICES={"qwen3-max":{"in":0.006,"out":0.024}}
